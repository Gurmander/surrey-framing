---
/** Quote request form, SRS FR-30 (fields), sent through FormShell. */
import FormShell from './FormShell.astro';
import TextField from './TextField.astro';
import SelectField from './SelectField.astro';
import RadioGroup from './RadioGroup.astro';
import TextareaField from './TextareaField.astro';
import { site } from '@/config/site';
import { getServices } from '@/lib/content';
import { useTranslations } from '@/i18n';

const t = useTranslations();
const q = t.forms.quote;
const f = q.fields;
const services = await getServices();
const asOptions = (labels: string[]) => labels.map((label) => ({ label }));
---

<FormShell
  id="quote-form"
  formType={q.formType}
  subject={q.subject}
  event="quote_submitted"
  trackField="Service"
  trackParam="service"
  submitLabel={q.submit}
  attachments
>
  <TextField
    id="q-name"
    name="Full name"
    label={f.name}
    required
    autocomplete="name"
    minlength={2}
    maxlength={80}
  />
  <div class="grid gap-6 sm:grid-cols-2">
    <TextField
      id="q-phone"
      name="Phone"
      label={f.phone}
      type="tel"
      required
      autocomplete="tel"
      validate="phone"
    />
    <TextField
      id="q-email"
      name="email"
      label={f.email}
      type="email"
      required
      autocomplete="email"
    />
  </div>
  <RadioGroup id="q-role" name="I am a" legend={f.role} options={f.roles} required />
  <SelectField
    id="q-service"
    name="Service"
    label={f.service}
    placeholder={f.servicePlaceholder}
    options={services.map((service) => ({ label: service.data.title, key: service.id }))}
    preselectParam="service"
    required
  />
  <TextField
    id="q-address"
    name="Project address or city"
    label={f.address}
    hint={f.addressHint}
    required
    autocomplete="street-address"
    list="q-cities"
  />
  <datalist id="q-cities">
    {site.serviceAreas.map((area) => (
      <option value={area.name} />
    ))}
  </datalist>
  <div class="grid gap-6 sm:grid-cols-2">
    <SelectField
      id="q-size"
      name="Project size"
      label={f.size}
      placeholder={f.choose}
      options={asOptions(f.sizes)}
    />
    <SelectField
      id="q-start"
      name="Desired start"
      label={f.start}
      placeholder={f.choose}
      options={asOptions(f.starts)}
    />
  </div>
  <RadioGroup
    id="q-drawings"
    name="Drawings"
    legend={f.drawings}
    options={f.drawingsOptions}
    required
  />
  <TextareaField id="q-details" name="Project details" label={f.details} hint={f.detailsHint} />
  <SelectField
    id="q-heard"
    name="How did you hear about us"
    label={f.heard}
    placeholder={f.choose}
    options={asOptions(f.heardOptions)}
  />
</FormShell>
