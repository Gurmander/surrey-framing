---
/**
 * Labelled input (SRS 4.4 form fields, NFR-23): 48 px tall, label above, hint and
 * error text linked with aria-describedby, "optional" marked in text.
 */
import { useTranslations } from '@/i18n';

interface Props {
  id: string;
  /** Field name as it appears in the email, e.g. "Full name". */
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'date';
  required?: boolean;
  autocomplete?: string;
  hint?: string;
  minlength?: number;
  maxlength?: number;
  /** Extra check run by the form script. */
  validate?: 'phone';
  /** id of a <datalist> with suggestions. */
  list?: string;
  class?: string;
}

const {
  id,
  name,
  label,
  type = 'text',
  required = false,
  autocomplete,
  hint,
  minlength,
  maxlength,
  validate,
  list,
  class: className,
} = Astro.props;
const t = useTranslations();
const describedBy = [hint && `${id}-hint`, `${id}-error`].filter(Boolean).join(' ');
---

<div class:list={['flex flex-col gap-2', className]} data-field>
  <label for={id} class="font-semibold">
    {label}
    {!required && <span class="font-normal text-muted"> ({t.forms.optional})</span>}
  </label>
  {hint && (
    <p id={`${id}-hint`} class="-mt-1 text-small text-muted">
      {hint}
    </p>
  )}
  <input
    id={id}
    name={name}
    type={type}
    required={required}
    autocomplete={autocomplete}
    minlength={minlength}
    maxlength={maxlength}
    list={list}
    data-validate={validate}
    pattern={validate === 'phone' ? String.raw`[0-9\(\)\+\-\.\s]{10,20}` : undefined}
    aria-describedby={describedBy}
    class="h-12 w-full rounded-btn border border-line bg-white px-4 text-ink transition-colors hover:border-slate aria-invalid:border-error"
  />
  <p id={`${id}-error`} class="text-small font-medium text-error" data-error hidden></p>
</div>
