---
/**
 * Site footer, SRS FR-11: ink background, 4 columns (brand, services, company,
 * contact) and a bottom row with © year, Privacy and the "Site by" credit.
 */
import { Icon } from 'astro-icon/components';
import Logo from '@/components/ui/Logo.astro';
import Badge from '@/components/ui/Badge.astro';
import { companyNav, routes } from '@/config/navigation';
import { getServices } from '@/lib/content';
import { isPlaceholder, site, whatsappHref } from '@/config/site';
import { fmt, getLangFromUrl, useTranslations } from '@/i18n';

const t = useTranslations(getLangFromUrl(Astro.url));
const services = await getServices();
const year = new Date().getFullYear();
// Each letter of the credit is its own span so it can wave on hover (credit-wordmark).
const creditLetters = [...site.credit.name];
const { address } = site;

const linkClass = 'inline-flex min-h-11 items-center py-1 transition-colors hover:text-amber';
const headingClass = 'font-display text-h3 font-semibold uppercase text-white';
---

<footer class="surface-ink" id="site-footer">
  <div class="container-site grid gap-10 py-16 md:grid-cols-2 lg:gap-12 lg:py-20 xl:grid-cols-[1.4fr_1.2fr_0.8fr_1fr]">
    <div class="flex flex-col items-start gap-5">
      <Logo />
      <p class="max-w-xs text-small text-muted">{site.pitch}</p>
      <ul class="flex flex-wrap gap-2">
        <li>
          <Badge tone="dark">{t.trust.worksafe}</Badge>
        </li>
        <li>
          <Badge tone="dark">{t.trust.insured}</Badge>
        </li>
        <li>
          <Badge tone="dark">{t.trust.estimates}</Badge>
        </li>
      </ul>
    </div>

    <nav aria-labelledby="footer-services">
      <h2 id="footer-services" class={headingClass}>
        {t.footer.services}
      </h2>
      <ul class="mt-4 text-small text-muted">
        {services.map((service) => (
          <li>
            <a href={routes.service(service.id)} class={linkClass}>
              {service.data.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-company">
      <h2 id="footer-company" class={headingClass}>
        {t.footer.company}
      </h2>
      <ul class="mt-4 text-small text-muted">
        {companyNav.map((link) => (
          <li>
            <a href={link.href} class={linkClass}>
              {t.nav[link.key]}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class={headingClass}>{t.footer.contact}</h2>
      <ul class="mt-4 flex flex-col gap-1 text-small text-muted">
        <li>
          <a href={site.phone.href} class:list={[linkClass, 'gap-3 font-semibold text-white']}>
            <Icon name="lucide:phone" class="size-5 flex-none text-amber" aria-hidden="true" />
            {site.phone.display}
          </a>
        </li>
        <li>
          <a
            href={whatsappHref(t.whatsapp.message)}
            target="_blank"
            rel="noopener"
            class:list={[linkClass, 'gap-3']}
          >
            <Icon name="whatsapp" class="size-5 flex-none text-amber" aria-hidden="true" />
            {t.whatsapp.label}
            <span class="sr-only"> ({t.a11y.newTab})</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class:list={[linkClass, 'gap-3 break-all']}>
            <Icon name="lucide:mail" class="size-5 flex-none text-amber" aria-hidden="true" />
            {site.email}
          </a>
        </li>
        <li class="flex gap-3 py-2">
          <Icon
            name="lucide:map-pin"
            class="mt-0.5 size-5 flex-none text-amber"
            aria-hidden="true"
          />
          {address.showStreet ? (
            <address class="not-italic">
              {address.street}
              <br />
              {address.city}, {address.region} {address.postalCode}
            </address>
          ) : (
            <span>{site.serviceAreaLabel}</span>
          )}
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-steel">
    <div class="container-site flex flex-col gap-2 py-6 text-small text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>{fmt(t.footer.copyright, { year, name: site.legalName })}</p>
      <!-- Right padding keeps these links clear of the round WhatsApp button. -->
      <ul class="flex flex-wrap items-center gap-x-6 sm:pr-20">
        <li>
          <a href={routes.privacy} class={linkClass}>
            {t.nav.privacy}
          </a>
        </li>
        {site.ga4Id && (
          <li>
            <button type="button" data-cookie-settings class={linkClass}>
              {t.consent.settings}
            </button>
          </li>
        )}
        <li>
          <span class="inline-flex items-center gap-2">
            {t.footer.siteBy}
            {!site.credit.url || isPlaceholder(site.credit.url) ? (
              <span class="credit-wordmark">
                {creditLetters.map((letter) => (
                  <span aria-hidden="true">{letter}</span>
                ))}
                <span class="sr-only">{site.credit.name}</span>
              </span>
            ) : (
              <a href={site.credit.url} class="credit-wordmark" target="_blank" rel="noopener">
                {creditLetters.map((letter) => (
                  <span aria-hidden="true">{letter}</span>
                ))}
                <span class="sr-only">
                  {site.credit.name} ({t.a11y.newTab})
                </span>
              </a>
            )}
          </span>
        </li>
      </ul>
    </div>
  </div>
</footer>
