---
/**
 * Google Analytics 4 with opt-in consent (SRS FR-75, FR-76, NFR-33).
 * - Nothing from Google loads until the visitor clicks "Allow analytics". The choice
 *   is stored in localStorage; "Cookie settings" in the footer reopens the banner.
 * - Tracks clicks on tel:, mailto: and WhatsApp links (FR-41). Form events are sent
 *   by the form script (FR-37). Events are only sent once consent is given.
 * Renders nothing when no measurement ID is configured.
 */
import { routes } from '@/config/navigation';
import { site } from '@/config/site';
import { getLangFromUrl, useTranslations } from '@/i18n';

interface Props {
  /** True when the mobile call bar is shown (banner sits above it). */
  aboveCallBar?: boolean;
}

const { aboveCallBar = true } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

{site.ga4Id && (
  <div
    data-consent
    data-ga-id={site.ga4Id}
    role="region"
    aria-label={t.consent.label}
    hidden
    class:list={[
      'surface-ink fixed inset-x-3 z-40 rounded-card p-5 shadow-card-hover md:inset-x-auto md:bottom-6 md:left-6 md:max-w-md',
      aboveCallBar
        ? 'bottom-[calc(4.5rem+env(safe-area-inset-bottom))]'
        : 'bottom-[calc(1rem+env(safe-area-inset-bottom))]',
    ]}
  >
    <p class="text-small">
      {t.consent.text}{' '}
      <a
        href={routes.privacy}
        class="font-semibold underline decoration-amber decoration-2 underline-offset-4"
      >
        {t.forms.privacy}
      </a>
    </p>
    <div class="mt-4 flex flex-wrap gap-3">
      <button
        type="button"
        data-consent-accept
        class="inline-flex h-11 items-center rounded-btn bg-amber px-5 text-btn font-semibold text-ink transition-colors hover:bg-amber-dark"
      >
        {t.consent.accept}
      </button>
      <button
        type="button"
        data-consent-decline
        class="inline-flex h-11 items-center rounded-btn border-2 border-white px-5 text-btn font-semibold transition-colors hover:bg-white hover:text-ink"
      >
        {t.consent.decline}
      </button>
    </div>
  </div>
)}

<script>
  import { track, type AnalyticsEvent } from '@/lib/analytics';

  const STORAGE_KEY = 'sf-analytics-consent';
  const banner = document.querySelector<HTMLElement>('[data-consent]');
  const gaId = banner?.dataset.gaId;

  function loadAnalytics(id: string) {
    if (window.gtag) return;
    window.dataLayer = window.dataLayer || [];
    window.gtag = function gtag() {
      // GA expects the arguments object itself.
      // eslint-disable-next-line prefer-rest-params
      window.dataLayer!.push(arguments);
    };
    window.gtag('js', new Date());
    window.gtag('config', id);
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
    document.head.append(script);
  }

  if (banner && gaId) {
    const read = () => {
      try {
        return localStorage.getItem(STORAGE_KEY);
      } catch {
        return null;
      }
    };
    const save = (value: 'granted' | 'denied') => {
      try {
        localStorage.setItem(STORAGE_KEY, value);
      } catch {
        // Private mode: the choice lasts for this page only.
      }
    };

    const choice = read();
    if (choice === 'granted') loadAnalytics(gaId);
    else if (choice !== 'denied') banner.hidden = false;

    banner.querySelector('[data-consent-accept]')?.addEventListener('click', () => {
      save('granted');
      banner.hidden = true;
      loadAnalytics(gaId);
    });
    banner.querySelector('[data-consent-decline]')?.addEventListener('click', () => {
      save('denied');
      banner.hidden = true;
      // Turning analytics off after it was on takes effect on the next page load.
    });

    // "Cookie settings" in the footer.
    document.addEventListener('click', (event) => {
      const trigger = (event.target as Element | null)?.closest('[data-cookie-settings]');
      if (!trigger) return;
      banner.hidden = false;
      banner.querySelector<HTMLElement>('[data-consent-accept]')?.focus();
    });
  }

  // FR-41: contact link clicks (no personal data; only the link type and page).
  document.addEventListener('click', (event) => {
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href]');
    if (!link) return;
    const href = link.getAttribute('href') ?? '';
    const custom = link.dataset.track as AnalyticsEvent | undefined;
    if (custom) track(custom);
    else if (href.startsWith('tel:')) track('call_click');
    else if (href.startsWith('mailto:')) track('email_click');
    else if (href.startsWith('https://wa.me/')) track('whatsapp_click');
  });
</script>
