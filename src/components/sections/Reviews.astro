---
/**
 * Reviews, SRS 5.2 §9 / FR-50, as a moving strip (owner request): cards slide right
 * to left and fade at the edges. The strip pauses on hover, keyboard focus or a tap
 * (it is focusable), and is static with reduced motion. The track is duplicated for
 * a seamless loop; the copy is hidden from screen readers. No average rating or
 * play/pause button (owner, 2026-11-05). Renders nothing when there are no
 * displayable reviews (production builds only show approved reviews).
 */
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ReviewCard from '@/components/ui/ReviewCard.astro';
import { getReviews } from '@/lib/content';
import { useTranslations } from '@/i18n';

interface Props {
  tone?: 'paper' | 'white';
}

const { tone = 'paper' } = Astro.props;
const t = useTranslations();
const reviews = await getReviews();
// About 7 seconds per card keeps the strip readable.
const duration = `${Math.max(reviews.length, 4) * 7}s`;
const cardClass = 'w-72 flex-none sm:w-80';
---

{reviews.length > 0 && (
  <Section tone={tone} labelledby="reviews-title" containerClass="overflow-hidden">
    <SectionHeading
      id="reviews-title"
      eyebrow={t.home.reviews.eyebrow}
      title={t.home.reviews.title}
    />
    <div
      class="review-marquee mt-7 py-3 lg:mt-11"
      data-duration={duration}
      role="region"
      aria-label={t.home.reviews.carousel}
      tabindex="0"
    >
      <ul>
        {reviews.map((review) => (
          <ReviewCard review={review} class={cardClass} />
        ))}
      </ul>
      <ul aria-hidden="true">
        {reviews.map((review) => (
          <ReviewCard review={review} class={cardClass} />
        ))}
      </ul>
    </div>
  </Section>
)}

<script>
  // Strip speed scales with the number of reviews. Set through CSSOM rather than
  // an inline style attribute so the Content Security Policy stays strict.
  document.querySelectorAll<HTMLElement>('.review-marquee[data-duration]').forEach((strip) => {
    strip.style.setProperty('--marquee-duration', strip.dataset.duration ?? '60s');
  });
</script>
