---
/** Grid of icon + title + text items (values, credentials, benefits, steps). */
import { Icon } from 'astro-icon/components';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

interface Props {
  items: { icon: string; title: string; text: string }[];
  tone?: 'paper' | 'white' | 'ink';
  id: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  /** Show step numbers instead of plain cards. */
  numbered?: boolean;
}

const { items, tone = 'white', id, eyebrow, title, intro, numbered = false } = Astro.props;
const cols = items.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4';
---

<Section tone={tone} labelledby={`${id}-title`}>
  <SectionHeading id={`${id}-title`} eyebrow={eyebrow} title={title} intro={intro} />
  <ul class:list={['mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:mt-14', cols]} data-reveal>
    {items.map((item, i) => (
      <li class="flex flex-col gap-3 border-t-2 border-amber pt-6">
        <span class="inline-flex size-12 items-center justify-center rounded-full bg-amber text-ink">
          {numbered ? (
            <span class="font-display text-h3 font-bold">{i + 1}</span>
          ) : (
            <Icon name={`lucide:${item.icon}`} class="size-6" aria-hidden="true" />
          )}
        </span>
        <h3 class="heading-3">{item.title}</h3>
        <p class="text-muted">{item.text}</p>
      </li>
    ))}
  </ul>
  <slot />
</Section>
