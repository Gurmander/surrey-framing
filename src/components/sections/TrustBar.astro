---
/**
 * Trust bar, SRS 4.4 / 5.2 §2: four icons with short labels. A white strip on
 * mobile; on desktop a white card that overlaps the bottom of the hero by 48 px.
 */
import { Icon } from 'astro-icon/components';
import { site } from '@/config/site';
import { fmt, useTranslations } from '@/i18n';

const t = useTranslations();
const items = [
  { icon: 'lucide:hard-hat', label: t.trust.worksafe },
  { icon: 'lucide:shield-check', label: t.trust.insured },
  { icon: 'lucide:hammer', label: fmt(t.trust.years, { years: site.facts.yearsInBusiness }) },
  { icon: 'lucide:clipboard-check', label: t.trust.estimates },
];
---

<section class="surface-white" aria-label={t.home.trust.label}>
  <div class="container-site">
    <ul class="relative z-10 grid grid-cols-2 gap-x-4 gap-y-6 py-8 lg:-mt-12 lg:grid-cols-4 lg:gap-6 lg:rounded-card lg:bg-white lg:px-10 lg:py-9 lg:shadow-card">
      {items.map((item) => (
        <li class="flex items-center gap-3">
          <span class="inline-flex size-11 flex-none items-center justify-center rounded-full bg-paper text-amber-dark">
            <Icon name={item.icon} class="size-6" aria-hidden="true" />
          </span>
          <span class="text-small leading-snug font-semibold break-words lg:text-body">
            {item.label}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
