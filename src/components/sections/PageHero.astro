---
/**
 * Inner page hero (SRS FR-20): about 40–50% of the viewport, H1, optional
 * breadcrumbs and an optional background photo with the DS-13 overlay. Sits under
 * the transparent header, so it reserves the header height at the top.
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Img from '@/components/ui/Img.astro';
import type { Crumb } from '@/lib/schema';

interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  highlight?: string;
  /** Image id from src/data/images.json. */
  image?: string;
  breadcrumbs?: Crumb[];
}

const { title, eyebrow, intro, highlight, image, breadcrumbs } = Astro.props;
---

<section class="surface-ink relative isolate flex min-h-[40vh] items-end overflow-hidden pt-header lg:min-h-[50vh] lg:pt-header-lg">
  {image && (
    <>
      <Img
        id={image}
        sizes="100vw"
        widths={[640, 960, 1280, 1600, 1920]}
        priority
        quality={45}
        pictureClass="absolute inset-0 -z-20"
        class="size-full object-cover"
      />
      <div
        class="absolute inset-0 -z-10 bg-ink/70 lg:bg-transparent lg:bg-linear-to-r lg:from-ink/85 lg:via-ink/60 lg:to-ink/25"
        aria-hidden="true"
      />
    </>
  )}
  <div class="container-site pt-12 pb-12 lg:pt-20 lg:pb-16">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} class="mb-6" />}
    <SectionHeading
      level={1}
      title={title}
      eyebrow={eyebrow}
      intro={intro}
      highlight={highlight}
      class="max-w-4xl"
    >
      <slot />
    </SectionHeading>
  </div>
</section>
