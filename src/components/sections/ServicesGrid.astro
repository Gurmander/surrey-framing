---
/** Grid of service cards, 1 → 2 → 3 columns (DS-09). Used on Home and /services/. */
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ServiceCard from '@/components/ui/ServiceCard.astro';
import Button from '@/components/ui/Button.astro';
import type { Service } from '@/lib/content';

interface Props {
  services: Service[];
  tone?: 'paper' | 'white';
  eyebrow?: string;
  title: string;
  intro?: string;
  /** Optional button under the grid, e.g. "All services". */
  cta?: { label: string; href: string };
}

const { services, tone = 'white', eyebrow, title, intro, cta } = Astro.props;
---

<Section tone={tone} labelledby="services-title">
  <SectionHeading id="services-title" eyebrow={eyebrow} title={title} intro={intro} />
  <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:mt-14 lg:grid-cols-3 lg:gap-8" data-reveal>
    {services.map((service) => (
      <ServiceCard service={service} />
    ))}
  </ul>
  {cta && (
    <div class="mt-10 lg:mt-14">
      <Button href={cta.href} variant="secondary">
        {cta.label}
      </Button>
    </div>
  )}
</Section>
