---
/**
 * TEMPORARY (Milestone 1): marks a page whose content has not been built yet.
 * Delete each usage as its page is built in Milestones 3–5.
 */
import { fmt, getLangFromUrl, useTranslations } from '@/i18n';

interface Props {
  milestone: number;
}

const { milestone } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<section class="surface-paper section-y">
  <div class="container-site flex flex-col items-start gap-6">
    <p class="max-w-prose text-muted">{fmt(t.stub.text, { milestone })}</p>
    <slot />
  </div>
</section>
