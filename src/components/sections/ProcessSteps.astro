---
/**
 * Numbered process steps, SRS 5.2 §7: horizontal with a connecting amber line on
 * desktop, vertical with a connecting line on mobile. Reused on service pages.
 */
import { Icon } from 'astro-icon/components';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getProcessSteps } from '@/lib/content';

interface Props {
  tone?: 'paper' | 'white';
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { tone = 'white', eyebrow, title, intro } = Astro.props;
const steps = await getProcessSteps();
---

<Section tone={tone} labelledby="process-title">
  <SectionHeading id="process-title" eyebrow={eyebrow} title={title} intro={intro} />
  <ol class="relative mt-10 grid gap-10 lg:mt-14 lg:grid-cols-4 lg:gap-8" data-reveal>
    <!-- Desktop connecting line through the step numbers -->
    <span
      class="absolute top-6 right-[12.5%] left-[12.5%] hidden h-0.5 bg-amber lg:block"
      aria-hidden="true"
    ></span>
    {steps.map(({ data }, i) => (
      <li class="relative flex gap-5 lg:flex-col lg:items-center lg:text-center">
        {i < steps.length - 1 && (
          <span
            class="absolute top-14 -bottom-8 left-6 w-0.5 bg-amber lg:hidden"
            aria-hidden="true"
          />
        )}
        <span class="relative z-10 inline-flex size-12 flex-none items-center justify-center rounded-full bg-amber font-display text-h3 font-bold text-ink">
          {data.step}
        </span>
        <div class="flex flex-col gap-2 lg:items-center">
          <Icon name={`lucide:${data.icon}`} class="size-6 text-amber-dark" aria-hidden="true" />
          <h3 class="heading-3">{data.title}</h3>
          <p class="max-w-xs text-muted">{data.text}</p>
        </div>
      </li>
    ))}
  </ol>
</Section>
