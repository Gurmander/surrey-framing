---
/**
 * Project card, SRS 4.4: 4:3 image with a bottom gradient, title + city + type badge
 * in white. Whole card clickable via the stretched title link.
 */
import Badge from './Badge.astro';
import Img from './Img.astro';
import { routes } from '@/config/navigation';
import type { Project } from '@/lib/content';

interface Props {
  project: Project;
  /** Heading level inside the page outline. */
  headingLevel?: 'h2' | 'h3';
  /** Value for client-side filtering (projects index). */
  filterKey?: string;
}

const { project, headingLevel: Heading = 'h3', filterKey } = Astro.props;
const { data } = project;
---

<li
  data-type={filterKey}
  class="group relative isolate flex aspect-[4/3] flex-col justify-end overflow-hidden rounded-card bg-steel shadow-card transition-[translate,box-shadow] duration-300 focus-within:-translate-y-1 hover:-translate-y-1 hover:shadow-card-hover"
>
  <Img
    id={data.cover}
    sizes="(min-width: 1280px) 400px, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
    widths={[400, 640, 800, 1000]}
    pictureClass="absolute inset-0 -z-10"
    class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
  />
  <div
    class="absolute inset-0 -z-10 bg-linear-to-t from-ink/90 via-ink/40 to-transparent"
    aria-hidden="true"
  ></div>
  <!-- Not positioned: the stretched link must cover the whole card, not this block. -->
  <div class="on-dark flex flex-col items-start gap-2 p-5">
    <Badge tone="dark">{data.type}</Badge>
    <Heading class="heading-3 text-white">
      <a href={routes.project(project.id)} class="link-stretched">
        {data.title}
      </a>
    </Heading>
    <p class="text-small text-line">{data.city}</p>
  </div>
</li>
