---
/**
 * Service detail stub. Milestone 2 switches getStaticPaths to the `services`
 * content collection; Milestone 4 builds the full FR-21 layout.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import PageStub from '@/components/sections/PageStub.astro';
import { serviceLinks } from '@/config/navigation';
import { fmt, useTranslations } from '@/i18n';

export const getStaticPaths = (() =>
  serviceLinks.map((service) => ({
    params: { slug: service.slug },
    props: { title: service.title },
  }))) satisfies GetStaticPaths;

const { title } = Astro.props;
const page = useTranslations().pages.service;
---

<BaseLayout
  title={fmt(page.metaTitle, { service: title })}
  description={fmt(page.metaDescription, { service: title })}
>
  <PageHero eyebrow={page.eyebrow} title={title} />
  <PageStub milestone={4} />
</BaseLayout>
