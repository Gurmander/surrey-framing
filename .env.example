# Copy to .env and fill in. Never commit .env (NFR-31).

# Web3Forms access key. Public by design, but kept out of the source code.
PUBLIC_FORM_ACCESS_KEY=

# Production URL, used for canonical tags, Open Graph and the sitemap.
PUBLIC_SITE_URL=https://surreyframing.ca

# Show placeholder reviews and "Sample" labels in a build (preview deploys only).
# Leave empty for production: placeholder reviews must never go live (SRS FR-50).
PUBLIC_SHOW_SAMPLE_CONTENT=
