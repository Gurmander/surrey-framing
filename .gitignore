# ---------------------------------------------------------------
node_modules/
dist/
.astro/
.cache/
coverage/
*.tsbuildinfo
.eslintcache
.lighthouseci/
# Hosting CLIs
.netlify/
.vercel/
# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Archives, videos and design/raw source files (keep web-ready images only)
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.mov
*.mp4
*.heic
*.raw
*.psd
*.ai
*.sketch

